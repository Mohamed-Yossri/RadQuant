# RadQuant — credentials template.
#
# On Lightning.ai these are typically provided as Studio "secret variables"
# (already exported into the environment), so you may not need this file at all.
# setup.py reads from the live environment FIRST, then from a .env file.
#
# If you do use a .env file, copy this to `.env` and fill in the values.

# HuggingFace token (read scope). https://huggingface.co/settings/tokens
# Used to download MedGemma 1.5 4B (license auto-approved on first access).
HF_TOKEN=

# Groq API key. https://console.groq.com
# NOTE: the Lightning secret for this project is named GROQ_TOKEN.
# setup.py accepts GROQ_TOKEN first, then GROQ_API_KEY as a fallback.
GROQ_TOKEN=

# (Optional) NVIDIA NIM API key — used for Phase 8 eval only (higher rate limits).
# https://build.nvidia.com/
NVIDIA_KEY=
