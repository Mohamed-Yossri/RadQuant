# ======================================
# RadQuant .gitignore
# ======================================

# ---------- Secrets / runtime ----------
.env
.env.runtime

# ---------- Data (large, downloaded) ----------
/data/
/external/

# ---------- Runtime artifacts ----------
/temp/
/logs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
*.egg

# ---------- Model / HF caches ----------
*.safetensors
*.bin

# ---------- IDE ----------
.idea/
.vscode/
.vscode-server
.cursor-server
.windsurf-server
.copilot/

# ---------- Lightning.ai studio dotfiles ----------
# This repo root doubles as the studio HOME dir — never track its dotfiles.
.cache/
.claude/
.claude.json
.config/
.dotnet/
.ipython/
.jupyter
.lightning_studio/
.nv/
.npm/
.nvm/
.oh-my-zsh/
.local/
.ssh/
.torchxrayvision/
.antigravity-ide-server/
.gemini/

# ---------- Shell / system ----------
.bash_history
.zsh_history
.zcompdump*
.zshrc
.bashrc
.profile
.condarc
.gitconfig
.hushlogin
.sudo_as_admin_successful
.vimrc
.wget-hsts
.docker
*.log

# ---------- Misc ----------
# stray root-level scratch file only — anchored so it never matches backend/main.py
/main.py
radquant.egg-info/

# ---------- Added per user request ----------
temp_node/
node_installer
*.exe
*.msi

# ---------- Node & Next.js ----------
node_modules/
.next/
out/
build/
.vercel/

# ---------- OS & Misc ----------
.DS_Store
Thumbs.db
backend/uploads/
backend/temp/
